{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memeria-dev3pack-arena",
  "account_id": "8368cf80fc31f029e1bfbc6a19f29b60",
  "compatibility_date": "2026-10-26",
  "main": "dist/arena-worker/worker.js",
  "no_bundle": true,
  "workers_dev": true,
  "assets": {
    "directory": "dist/arena-worker-assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ARENAS", "class_name": "RugwyrmRun" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RugwyrmRun"] }]
}
